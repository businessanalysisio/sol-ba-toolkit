# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI provider configuration
# "claude" routes generation through the Claude Agent SDK, which reuses the
# Claude Code login on the machine — a Claude subscription works, no API key.
# "google" uses Gemini and needs the key below. Unset auto-picks: google when a
# key is present, otherwise claude.
AI_PROVIDER=
# Cosmetic only — labels the badge on the AI Copilot page.
NEXT_PUBLIC_AI_PROVIDER=
# Optional. Unset means "whatever model Claude Code is configured to use".
CLAUDE_AGENT_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Defaults to gemini-2.5-flash. The Gemini 1.5 series is no longer
# available to new API projects, so only override this if you have access.
GOOGLE_GENERATIVE_AI_MODEL=

# Server-only Jira integration configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Retrieval stack (infra/docker-compose.yml). Defaults match the compose file,
# so a local checkout needs none of these set.
QDRANT_URL=
QDRANT_COLLECTION=
NEO4J_URL=
NEO4J_USER=
NEO4J_PASSWORD=
OLLAMA_URL=
EMBED_MODEL=
EMBED_DIMENSIONS=
# Similarity below which a source may not support an answer. Raising this
# silently turns a refusal into a fabrication — change it deliberately.
RETRIEVAL_THRESHOLD=
RETRIEVAL_CANDIDATES=
